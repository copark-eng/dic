# Exclude all top-level directories and files except server/ and .gitignore
/*
!/server/
!/.gitignore

# Exclude server_requirements.md and README from server/
/server/server_requirements.md
/server/README.md

# Exclude heavy raw source dumps (kengdic, oxford csv)
/server/raw/kengdic.tsv
/server/raw/oxford-*.csv

# Exclude local test batch runner
/server/run_builder.bat

